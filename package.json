{
    "name": "tsheredoc",
    "description": "Javascript heredoc with typescript support.",
    "keywords": [
        "heredoc"
    ],
    "version": "1.0.0",
    "author": {
        "name": "Jason Walton",
        "email": "dev@lucid.thedreaming.org",
        "url": "https://thedreaming.org"
    },
    "license": "MIT",
    "sideEffects": false,
    "main": "./dist/index.js",
    "type": "module",
    "files": [
        "dist/**/*"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jwalton/tsheredoc.git"
    },
    "bugs": {
        "url": "https://github.com/jwalton/tsheredoc/issues"
    },
    "homepage": "https://github.com/jwalton/tsheredoc#readme",
    "scripts": {
        "start": "npm run build && node dist/index.js",
        "test": "npm run build && npm run lint && npm run test:unittest",
        "build": "tsc",
        "clean": "rm -rf dist types coverage",
        "test:unittest": "c8 mocha src",
        "lint": "npm run lint:source && npm run lint:types",
        "lint:source": "eslint src",
        "lint:types": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
        "prepare": "husky || true",
        "prepublishOnly": "npm run build && npm test",
        "semantic-release": "semantic-release"
    },
    "lint-staged": {
        "**/*.@(ts|tsx)": [
            "prettier --write",
            "eslint"
        ],
        "**/*.@(js|cjs|mjs|jsx)": [
            "prettier --write"
        ]
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/chai": "^5.2.3",
        "@types/mocha": "^10.0.10",
        "@types/node": "^25.9.1",
        "@types/sinon": "^21.0.1",
        "c8": "^11.0.0",
        "chai": "^6.2.2",
        "eslint": "^10.4.1",
        "husky": "^9.1.7",
        "lint-staged": "^17.0.5",
        "mocha": "^11.7.6",
        "prettier": "^3.8.3",
        "sinon": "^22.0.0",
        "ts-node": "^10.9.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.60.0"
    }
}
